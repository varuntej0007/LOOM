<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LOOM Studio is fully on-device. Strip network access even if a library declares it,
         so "offline" is enforced by the manifest, not by convention. Telemetry leaves the
         phone only through logcat over the USB / adb debug link. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Vision pipelines read the camera (asked at run time, only when a vision model runs). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Long runs live in a foreground service so Android does not kill them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the 1 Hz telemetry and the Weaver ticking with the screen off (normal permission). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- LOOM Guard (phone-wide cooling while any app runs). All optional, all user/adb-granted,
         none needs root:
           SYSTEM_ALERT_WINDOW   heat pill over other apps   ("Display over other apps")
           WRITE_SETTINGS        screen brightness            ("Modify system settings")
           WRITE_SECURE_SETTINGS 60 Hz cap + battery saver    (adb pm grant, by build_studio.bat)
           PACKAGE_USAGE_STATS   name of the app on screen     ("Usage access"; log only) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: bind the phone's text-to-speech engine (Voice chiplet). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".StudioApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LoomStudio">

        <!-- LiteRT GPU delegate: let the app load the vendor OpenCL driver (Android 12+),
             otherwise the delegate falls back to the slower OpenGL path. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse: on-device AI inference host. Later milestones add the "camera" and
             "microphone" types for vision and audio runs, while those runs are active. -->
        <service
            android:name=".service.RunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device AI model host and heat guard: runs user-imported models locally, adapts them to device heat and battery, and keeps the phone cool while other apps run" />
        </service>
    </application>
</manifest>
