<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system launch screen: the infinity mark on black, then LoomIntro takes over. -->
    <style name="Theme.Loom" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/loom_bg</item>
        <item name="android:statusBarColor">@color/loom_bg</item>
        <item name="android:navigationBarColor">@color/loom_bg</item>
        <item name="android:windowSplashScreenBackground">@color/loom_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/loom_bg</item>
    </style>
</resources>
