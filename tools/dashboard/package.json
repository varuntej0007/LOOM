{
  "name": "loom-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "LOOM live dashboard (React). Built bundle is committed in dist/, so the laptop needs no npm.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --target=es2019 --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.23.1"
  }
}
